{
  "name": "world-clocks-chrome-extension",
  "version": "1.1.2",
  "description": "Minimalistic World Clocks Chrome Extension (Manifest V3) with Analog & Digital modes, responsive analog grid, and Dark/Light theme toggle.",
  "private": true,
  "scripts": {
    "icons": "node scripts/generate-icons.js",
    "pack": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package.ps1",
    "screenshots": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/screenshots.ps1",
    "validate": "node scripts/validate.js"
  },
  "keywords": [
    "chrome-extension",
    "manifest-v3",
    "world-clock",
    "timezone",
    "analog-clock",
    "digital-clock"
  ],
  "license": "MIT"
}
